{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "company-fleets/workload.schema.json",
  "title": "Workload record",
  "description": "A bounded unit of work the router can hand to one fleet. Lists the smallest role set; by_profile adds roles only for named operating profiles. Lives in the owning fleet's roles.json so each fleet edits only its own files.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "profiles", "roles"],
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/workload_id"},
    "name": {"$ref": "common.schema.json#/$defs/text"},
    "description": {"$ref": "common.schema.json#/$defs/text"},
    "profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/slug"}},
    "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/role_id"}},
    "by_profile": {
      "type": "object",
      "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/role_id"}}
    },
    "stages": {"$ref": "common.schema.json#/$defs/text_list_or_empty"}
  }
}
