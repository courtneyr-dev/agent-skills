{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "company-fleets/role.schema.json",
  "title": "Role record",
  "description": "One professional viewpoint with explicit decision rights. A persona is not a credential. No role dispatches: the existing router is the only top-level dispatcher, so dispatch is always false.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "display_name", "fleet", "kind", "dispatch", "purpose", "responsibilities", "exclusions",
    "activation_triggers", "authority_boundary", "required_context", "tools", "skills", "inputs",
    "outputs", "acceptance_criteria", "relations", "data_access", "external_actions", "budget",
    "cancellation", "handoff", "voice", "limitations", "verification", "evals"
  ],
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/role_id"},
    "display_name": {"$ref": "common.schema.json#/$defs/text"},
    "fleet": {"$ref": "common.schema.json#/$defs/slug"},
    "kind": {"enum": ["coordinator", "specialist"]},
    "dispatch": {"const": false},
    "purpose": {"$ref": "common.schema.json#/$defs/text"},
    "responsibilities": {"$ref": "common.schema.json#/$defs/text_list"},
    "exclusions": {"$ref": "common.schema.json#/$defs/text_list"},
    "activation_triggers": {"$ref": "common.schema.json#/$defs/text_list"},
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["may", "may_not"],
      "properties": {
        "may": {"$ref": "common.schema.json#/$defs/text_list"},
        "may_not": {"$ref": "common.schema.json#/$defs/text_list"}
      }
    },
    "required_context": {"$ref": "common.schema.json#/$defs/text_list"},
    "tools": {"$ref": "common.schema.json#/$defs/text_list_or_empty"},
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "provenance"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/slug"},
          "provenance": {"$ref": "common.schema.json#/$defs/text"},
          "blocked_reason": {"$ref": "common.schema.json#/$defs/text"}
        }
      }
    },
    "inputs": {"$ref": "common.schema.json#/$defs/text_list"},
    "outputs": {"$ref": "common.schema.json#/$defs/text_list"},
    "acceptance_criteria": {"$ref": "common.schema.json#/$defs/text_list"},
    "relations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewers", "acceptor", "escalation"],
      "properties": {
        "reviewers": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/principal"}},
        "acceptor": {"$ref": "common.schema.json#/$defs/principal"},
        "escalation": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/principal"}}
      }
    },
    "data_access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_classification", "tenant_scoped"],
      "properties": {
        "max_classification": {"$ref": "common.schema.json#/$defs/classification"},
        "tenant_scoped": {"type": "boolean"}
      }
    },
    "external_actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "limits"],
      "properties": {
        "mode": {"enum": ["none", "draft-only", "human-approved"]},
        "limits": {"$ref": "common.schema.json#/$defs/text_list"}
      }
    },
    "budget": {"$ref": "common.schema.json#/$defs/budget"},
    "cancellation": {"$ref": "common.schema.json#/$defs/text"},
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "next_consumers", "readiness"],
      "properties": {
        "schema": {"const": "handoff.v1"},
        "next_consumers": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/principal"}},
        "readiness": {"$ref": "common.schema.json#/$defs/text_list"}
      }
    },
    "voice": {"$ref": "common.schema.json#/$defs/text"},
    "limitations": {"$ref": "common.schema.json#/$defs/text_list"},
    "verification": {"$ref": "common.schema.json#/$defs/verification"},
    "evals": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/eval_id"}}
  }
}
