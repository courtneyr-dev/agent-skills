# company-fleets settings. Every one is optional; copy the lines you need into your shell profile.
# With none set, the defaults below apply and every path is relative to the skills root that holds
# company-fleets (the folder above this one).

# Upstream clones that sources/build_sources.py reads to rebuild sources/ledger.json.
# Default: <skills-root>/factory-rig/upstream, the same variable and default factory-rig uses.
# export FRIG_UPSTREAM_ROOT=/absolute/path/to/upstream-clones

# skill-sync's home: its registry (sources.json) and clone cache (repos/). sources/verify_sources.py
# and sources/build_sources.py read both through skill-sync, which defines the default.
# export SKILL_SYNC_HOME=/absolute/path/to/skill-sync-home

# A node_modules folder holding playwright and axe-core. The live keyboard checks in the agency
# fleet's eval cases, its demo (fleets/agency/demo/run_demo.py) and demos/01 read it; without it
# those steps exit 3 (missing capability).
# export AGENCY_A11Y_NODE_MODULES=/absolute/path/to/node_modules

# skill-creator's quick_validate.py, for `python3 fleets/hosting/tools/evalrun.py skills`.
# Unset: that step is skipped and the report says so.
# export FLEET_QUICK_VALIDATE=/absolute/path/to/skill-creator/scripts/quick_validate.py
