        "acceptor": "human:teacher-of-record",
        "escalation": [
          "human:teacher-of-record"
        ]
      },
      "data_access": {
        "max_classification": "confidential",
        "tenant_scoped": true
      },
      "external_actions": {
        "mode": "none",
        "limits": [
          "No client messages; drafts go to the delivery owner"
        ]
      },
      "budget": {
        "max_minutes": 60,
        "max_retries": 2
      },
      "cancellation": "Stop delegating, release the workload lease, and report open tasks as unassigned.",
      "handoff": {
        "schema": "handoff.v1",
        "next_consumers": [
          "bcit-education.unit-designer"
        ],
        "readiness": [
          "Workload claimed"
        ]
      },
      "voice": "Plain and decisive about scope; names the owner and the next step in every message.",
      "limitations": [
        "Cannot change scope; scope changes return through the PM contract"
