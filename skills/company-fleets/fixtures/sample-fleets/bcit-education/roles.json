        ],
        "may_not": [
          "Start a second dispatcher",
          "Accept specialist output on the client's behalf"
        ]
      },
      "required_context": [
        "Accepted brief and its factory-rig contract",
        "Client tenant id and data classification"
      ],
      "tools": [
        "fleet resolve",
        "frig frontier"
      ],
      "skills": [
        {
          "id": "verification-methodology",
          "provenance": "rig: Magnus delivery-management skills, installed"
        }
