{
  "schema_version": 1,
  "skill": "toy-gate",
  "label": "SYNTHETIC probes for the toy gate the pack's own tests mutate",
  "copy": ["inputs"],
  "command": ["{python}", "{skill}/gate.py", "--request", "{work}/inputs/request.json", "--approval", "{work}/inputs/approval.json",
              "--policy", "{work}/inputs/policy.json", "--suppression", "{work}/inputs/suppression.txt", "--base", "{work}/inputs"],
  "accepted_when": {"exit": [0], "contains": ["alice@example.com"], "absent": ["carol@example.com"]},
  "probes": [
    {"name": "relabel-kind-after-approval", "class": "approval-binding",
     "transforms": [{"op": "relabel", "file": "inputs/request.json", "pointer": "/kind", "value": "transactional"}],
     "refused_when": [{"exit": [1, 2]}]},
    {"name": "grow-audience-after-approval", "class": "approval-binding",
     "transforms": [{"op": "grow-list", "file": "inputs/request.json", "pointer": "/audience", "add": ["mallory@example.com"]}],
     "refused_when": [{"exit": [1, 2]}]},
    {"name": "delete-producer", "class": "producer-acceptor",
     "transforms": [{"op": "json-delete", "file": "inputs/request.json", "pointer": "/producer"}],
     "refused_when": [{"exit": [1, 2]}]},
    {"name": "pad-acceptor", "class": "producer-acceptor",
     "transforms": [{"op": "pad", "file": "inputs/request.json", "pointer": "/acceptor", "with": " "}],
     "refused_when": [{"exit": [1, 2]}]},
    {"name": "negative-amount", "class": "author-threshold",
     "transforms": [{"op": "number-edge", "file": "inputs/request.json", "pointer": "/amount", "variant": "negative"}],
     "refused_when": [{"exit": [1, 2]}]},
    {"name": "empty-amount", "class": "author-threshold",
     "transforms": [{"op": "number-edge", "file": "inputs/request.json", "pointer": "/amount", "variant": "empty"}],
     "refused_when": [{"exit": [1, 2]}]},
    {"name": "evidence-outside-base", "class": "path-outside-base",
     "transforms": [{"op": "path-outside-base", "file": "inputs/request.json", "pointer": "/evidence/path",
                     "target": "../../../../../../../../etc/hosts", "hash_pointer": "/evidence/sha256"}],
     "refused_when": [{"exit": [1, 2]}]},
    {"name": "suppression-trailing-dot", "class": "malformed-rows",
     "transforms": [{"op": "address-variant", "file": "inputs/suppression.txt", "match": "carol@example.com", "variant": "trailing-dot"}],
     "refused_when": [{"exit": [1, 2]}, {"exit": [0], "absent": ["carol@example.com"]}]},
    {"name": "suppression-zero-width", "class": "malformed-rows",
     "transforms": [{"op": "address-variant", "file": "inputs/suppression.txt", "match": "carol@example.com", "variant": "zero-width"}],
     "refused_when": [{"exit": [1, 2]}, {"exit": [0], "absent": ["carol@example.com"]}]},
    {"name": "suppression-plus-tag", "class": "malformed-rows",
     "transforms": [{"op": "address-variant", "file": "inputs/suppression.txt", "match": "carol@example.com", "variant": "plus-tag"}],
     "refused_when": [{"exit": [1, 2]}, {"exit": [0], "absent": ["carol@example.com"]}]}
  ]
}
