    {
      "id": "product-payment-events",
      "fleet": "product",
      "summary": "Test-mode payment, entitlement and subscription webhook processing where replays and retries cannot create a second capture, fulfillment, decrement or refund.",
      "triggers": [
        "Building or reviewing commerce, licensing, subscription or SaaS billing integrations",
        "Proving webhook idempotency or inventory-race behavior"
      ],
      "boundaries": [
        "Test mode only; live-mode events are refused",
        "No real provider accounts, card data, tax or chargeback rules"
      ],
      "inputs": [
        "payment-config.v1",
        "payment-event.v1 JSON lines signed with the published test key"
      ],
      "prerequisites": [
        "python3 with sqlite3"
      ],
      "method": [
        "Sign fixture events",
        "Process into a disposable store",
        "Replay and race",
        "Reconcile",
        "Hand holds to a human"
      ],
      "stopping_conditions": [
        "All events applied or refused and reconcile ran",
        "Any refusal or hold stops for a human"
      ],
      "output_contract": "process prints per-event outcomes, store counts, inventory, entitlements and live_calls 0; reconcile prints mismatches and holds; exit 0, 1 or 2.",
      "failure_states": [
        "Bad signature, live mode, foreign tenant: refused",
        "Stock exhausted: held for a human",
        "Invalid input: exit 2"
      ],
