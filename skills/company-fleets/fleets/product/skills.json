{
  "schema_version": 1,
  "fleet": "product",
  "skills": [
    {
      "id": "product-release-gate",
      "fleet": "product",
      "summary": "Packaging gate: compatibility first, then SemVer and channel, changelog, SBOM licenses and advisories, migration and rollback, the platform's own marketplace checklist, and fresh hash-bound evidence.",
      "triggers": [
        "Before asking a human to approve packaging or distribution of an extension, theme, module, SDK or SaaS release",
        "Checking a host/API/version compatibility matrix"
      ],
      "boundaries": [
        "Never approves, tags or publishes",
        "A checklist for one platform never validates another"
      ],
      "inputs": [
        "compat-matrix.v1",
        "release-candidate.v1",
        "handoff.v1 and factory-rig contract"
      ],
      "prerequisites": [
        "release-engineering scripts beside it",
        "company-fleets fleetlib over factory-rig"
      ],
      "method": [
        "Run compat on the matrix",
        "Run gate on the candidate",
        "Fix refusals at their source and rebind evidence",
        "Hand ready results to the human release owner"
      ],
      "stopping_conditions": [
        "Compatibility refused: later stages not-run",
        "All stages ran"
      ],
      "output_contract": "JSON with decision (ready-for-human-approval, refused, blocked), approval_owner, per-stage status and error codes; exit 0, 1 or 2.",
      "failure_states": [
        "Missing adapter: stage blocked with the path",
        "Unpinned marketplace: decision blocked",
        "An input rehashed without a new review naming its bytes: refused",
        "Invalid input: exit 2"
      ],
      "references": [
        {
          "title": "Semantic Versioning",
          "location": "https://semver.org/spec/v2.0.0.html",
          "version": "2.0.0",
          "rights": "CC BY 3.0"
        },
        {
          "title": "Keep a Changelog",
          "location": "https://keepachangelog.com/en/1.1.0/",
          "version": "1.1.0",
          "rights": "MIT"
        },
        {
          "title": "CycloneDX JSON",
          "location": "https://cyclonedx.org/docs/1.5/json/",
          "version": "1.5",
          "rights": "Apache-2.0"
        },
        {
          "title": "magnus919/agent-skills release-engineering scripts",
          "location": "skills/release-engineering/scripts",
          "version": "upstream 6806511",
          "rights": "MIT"
        }
      ],
      "scripts": [
        "scripts/release_gate.py",
        "scripts/tests/test_release_gate.py",
        "scripts/tests/fixture_handoff.py"
      ],
      "evals": {
        "positive": [
          "product.eval.gate-ready-candidate"
        ],
        "negative": [
          "product.eval.incompatible-host-refused-before-packaging",
          "product.eval.retired-api-version-refused",
          "product.eval.wordpress-review-not-valid-for-shopify",
          "product.eval.release-gate-rejects-invalid-input",
          "product.eval.candidate-claims-need-review",
          "product.eval.producer-review-refused",
          "product.eval.migration-must-be-declared",
          "product.eval.inverted-or-empty-compat-refused"
        ],
        "boundary": [
          "product.eval.untested-declared-version-refused",
          "product.eval.stale-matrix-evidence-refused",
          "product.eval.contract-edited-evidence-stale",
          "product.eval.unpinned-marketplace-blocks",
          "product.eval.rehash-without-review-refused"
        ]
      },
      "adapters": [
        {
          "name": "release-engineering semver_check.py and changelog_check.py",
          "kind": "cli",
          "required": true
        },
        {
          "name": "company-fleets fleetlib handoff validation",
          "kind": "cli",
          "required": true
        }
      ],
      "missing_capability": "A missing adapter blocks its stage and the decision becomes blocked; the gate never reports ready without it.",
      "provenance": {
