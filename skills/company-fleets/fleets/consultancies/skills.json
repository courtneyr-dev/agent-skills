    {
      "id": "consult-compliance-engagement",
      "fleet": "consultancies",
      "summary": "Six-stage compliance engagement gate: applicability, control owners, evidence collection, gap remediation, independent review, authorized report.",
      "triggers": [
        "Scoping, running or reporting a compliance or audit-readiness engagement"
      ],
      "boundaries": [
        "Never certifies, attests or gives a legal conclusion",
        "Unregistered frameworks are refused, not improvised"
      ],
      "inputs": [
        "compliance-engagement.v1",
        "--evidence-root holding <tenant_id>/<ref> artifacts",
        "Optional compliance-os framework_selector JSON"
      ],
      "prerequisites": [
        "python3"
      ],
      "method": [
        "Resolve applicability",
        "Name human control owners",
        "Collect hashed evidence",
        "Remediate or accept gaps",
        "Independent review",
        "Human authorization"
      ],
      "stopping_conditions": [
        "All six stages ran"
      ],
      "output_contract": "JSON stages with error codes and a decision (report-may-issue, ready-for-human-authorization, not-ready); exit 0, 1 or 2.",
      "failure_states": [
        "Licensed text not obtained",
        "Framework unregistered",
        "Invalid input exit 2"
      ],
      "references": [
        {
          "title": "Applicability registry",
          "location": "skills/consult-compliance-engagement/references/applicability-registry.json",
