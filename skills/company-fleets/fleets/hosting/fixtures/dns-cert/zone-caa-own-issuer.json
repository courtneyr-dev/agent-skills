{
  "label": "SYNTHETIC: a zone that names its own issuer and a CAA record permitting only that issuer.",
  "origin": "tenant-a.example",
  "issuer": "evil-ca.example",
  "records": [
    {
      "name": "@",
      "type": "A",
      "ttl": 3600,
      "value": "192.0.2.10"
    },
    {
      "name": "@",
      "type": "MX",
      "ttl": 3600,
      "value": "10 mail.tenant-a.example."
    },
    {
      "name": "@",
      "type": "TXT",
      "ttl": 3600,
      "value": "v=spf1 include:_spf.mailer.example -all"
    },
    {
      "name": "mail",
      "type": "A",
      "ttl": 3600,
      "value": "192.0.2.25"
    },
    {
      "name": "www",
      "type": "CNAME",
      "ttl": 3600,
      "value": "edge.platform.example."
    },
    {
      "name": "@",
      "type": "CAA",
      "ttl": 300,
      "value": "0 issue \"evil-ca.example\""
    }
  ]
}
