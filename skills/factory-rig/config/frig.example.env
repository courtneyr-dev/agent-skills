# factory-rig configuration. Every value is optional; the default applies when a variable is unset.
# Copy to a file outside version control and `source` it, or export the lines you need.
# <skill> is the factory-rig folder; <skills-root> is the folder that holds it.

# Provider policy the bin/codex and bin/claude shims read. The wrapper refuses to launch (exit 64)
# when the file is missing. Start from config/provider-policy.example.json.
# Default: <skill>/config/provider-policy.json (ignored by git)
# export FRIG_POLICY=/absolute/path/to/provider-policy.json

# Noodle binary for `frig noodle-run` and the real-Noodle integration test. The rig is tested
# against the build pinned in registry/components.json (revision 82d2921).
# Default: `noodle` on PATH
# export FRIG_NOODLE_BIN=/absolute/path/to/noodle

# yysun project-manager skill folder (the fixture and the flow tests run its node scripts).
# A workspace names its own copy in .factory-rig/config.json (`yysun_skill_dir`).
# Default: <skills-root>/project-manager
# export FRIG_YYSUN_SKILL=/absolute/path/to/project-manager

# Folder holding one git clone per pinned upstream, named by each component's `clone` field
# (noodle, pmo-platform, project-manager, curia, mattpocock-skills, agent-skills). Read by `frig drift`.
# Default: <skill>/upstream (ignored by git)
# export FRIG_UPSTREAM_ROOT=/absolute/path/to/upstream-clones

# Codex's own home. Dispatch reads $CODEX_HOME/models_cache.json to refuse a model slug the
# account cannot use; with no cache it lets the provider decide.
# Default: ~/.codex
# export CODEX_HOME=/absolute/path/to/codex-home

# Audit log for provider launches. Overrides the policy file's `audit` value.
# Default: the policy's `audit`, or no log when both are empty
# export FRIG_AUDIT=/absolute/path/to/provider-audit.jsonl

# Test hooks: replace the policy's `real` provider path (the fake-provider tests use these).
# export FRIG_REAL_CODEX=/absolute/path/to/codex
# export FRIG_REAL_CLAUDE=/absolute/path/to/claude

# Workspace for the backlog adapter's `done` callback log (bin/frig-backlog).
# Default: the current directory
# export FRIG_WS=/absolute/path/to/workspace
