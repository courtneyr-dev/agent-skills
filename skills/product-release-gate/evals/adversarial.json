{
  "schema_version": 1,
  "skill": "product-release-gate",
  "label": "SYNTHETIC adversarial probes over this skill's own fixtures, run by company-fleets bin/fleet adversarial",
  "copy": ["fixtures"],
  "command": ["{python}", "{skill}/scripts/release_gate.py", "gate", "--candidate", "{work}/fixtures/candidate-ok.json"],
  "accepted_when": {"exit": [0], "contains": ["ready-for-human-approval"]},
  "probes": [
    {"name": "api-change-relabeled-and-rehashed", "class": "recomputed-hash",
     "transforms": [{"op": "relabel", "file": "fixtures/candidate-ok.json", "pointer": "/public_api_change", "value": "additive"},
                    {"op": "rehash-handoff", "file": "fixtures/handoff.json", "base": "fixtures", "outputs": ["candidate-ok.json"]}],
     "refused_when": [{"exit": [1, 2]}]},
    {"name": "own-license-allowlist-grown", "class": "self-written-policy",
     "transforms": [{"op": "grow-list", "file": "fixtures/candidate-ok.json", "pointer": "/license_policy/allowed", "add": ["AGPL-3.0-only"]},
                    {"op": "rehash-handoff", "file": "fixtures/handoff.json", "base": "fixtures", "outputs": ["candidate-ok.json"]}],
     "refused_when": [{"exit": [1, 2]}]},
    {"name": "advisory-status-relabeled", "class": "label-content",
     "transforms": [{"op": "relabel", "file": "fixtures/candidate-ok.json", "pointer": "/vulnerabilities/0/status", "value": "fixed"},
                    {"op": "rehash-handoff", "file": "fixtures/handoff.json", "base": "fixtures", "outputs": ["candidate-ok.json"]}],
     "refused_when": [{"exit": [1, 2]}]},
    {"name": "migration-schema-negative", "class": "author-threshold",
     "transforms": [{"op": "number-edge", "file": "fixtures/candidate-ok.json", "pointer": "/migration/schema_to", "variant": "negative"},
                    {"op": "rehash-handoff", "file": "fixtures/handoff.json", "base": "fixtures", "outputs": ["candidate-ok.json"]}],
     "refused_when": [{"exit": [1, 2]}]},
    {"name": "changelog-heading-flipped", "class": "header-over-content",
     "transforms": [{"op": "text-replace", "file": "fixtures/CHANGELOG.md", "old": "## [2.0.0] - 2026-11-25", "new": "## [1.4.3] - 2026-11-25"},
                    {"op": "rehash-handoff", "file": "fixtures/handoff.json", "base": "fixtures", "outputs": ["CHANGELOG.md"]}],
     "refused_when": [{"exit": [1, 2]}]},
    {"name": "producer-deleted", "class": "producer-acceptor",
     "transforms": [{"op": "json-delete", "file": "fixtures/handoff.json", "pointer": "/producer"}],
     "refused_when": [{"exit": [1, 2]}]},
    {"name": "producer-padded", "class": "producer-acceptor",
     "transforms": [{"op": "pad", "file": "fixtures/handoff.json", "pointer": "/producer", "with": " "}],
     "refused_when": [{"exit": [1, 2]}]},
    {"name": "producer-made-acceptor", "class": "producer-acceptor",
     "transforms": [{"op": "relabel", "file": "fixtures/handoff.json", "pointer": "/acceptance_owner", "value": "product.release-engineer"}],
     "refused_when": [{"exit": [1, 2]}]},
    {"name": "tenant-moved-by-worker", "class": "worker-tenant",
     "transforms": [{"op": "relabel", "file": "fixtures/handoff.json", "pointer": "/tenant_id", "value": "tenant-b"}],
     "refused_when": [{"exit": [1, 2]}]},
    {"name": "evidence-outside-base", "class": "path-outside-base",
     "transforms": [{"op": "path-outside-base", "file": "fixtures/handoff.json", "pointer": "/evidence/0/path",
                     "target": "../../../../../../../../etc/hosts", "hash_pointer": "/evidence/0/sha256"}],
     "refused_when": [{"exit": [1, 2]}]}
  ]
}
